generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model attendances {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  class_id   BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  present    Boolean   @default(false)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  classes    classes   @relation(fields: [class_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendances_class_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "attendances_user_id_foreign")

  @@unique([class_id, user_id], map: "attendances_class_id_user_id_unique")
  @@index([user_id], map: "attendances_user_id_foreign")
}

model avatars {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  avatar     String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "avatars_user_id_foreign")

  @@index([user_id], map: "avatars_user_id_foreign")
}

model blogs {
  id          BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  title       String      @db.VarChar(255)
  slug        String      @db.VarChar(255)
  category    String      @db.VarChar(255)
  author      String      @db.VarChar(255)
  anticipated String      @db.MediumText
  body        String      @db.LongText
  image       String      @db.VarChar(255)
  created_at  DateTime?   @db.Timestamp(0)
  updated_at  DateTime?   @db.Timestamp(0)
  comments    comments[]
  like_blog   like_blog[]
}

model cache {
  key        String @id @db.VarChar(255)
  value      String @db.MediumText
  expiration Int
}

model cache_locks {
  key        String @id @db.VarChar(255)
  owner      String @db.VarChar(255)
  expiration Int
}

model classes {
  id          BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  title       String        @db.VarChar(255)
  date        DateTime?     @db.Date
  start_time  DateTime?     @db.Time(0)
  pdf         String?       @db.VarChar(255)
  powerpoint  String?       @db.VarChar(255)
  video       String?       @db.VarChar(255)
  meet_link   String?       @db.VarChar(255)
  work        Boolean       @default(false)
  homework    String?       @db.VarChar(255)
  course_id   BigInt        @db.UnsignedBigInt
  created_at  DateTime?     @db.Timestamp(0)
  updated_at  DateTime?     @db.Timestamp(0)
  attendances attendances[]
  courses     courses       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "classes_course_id_foreign")

  @@index([course_id], map: "classes_course_id_foreign")
}

model comments {
  id           BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  user_id      BigInt         @db.UnsignedBigInt
  blog_id      BigInt         @db.UnsignedBigInt
  content      String         @db.Text
  created_at   DateTime?      @db.Timestamp(0)
  updated_at   DateTime?      @db.Timestamp(0)
  blogs        blogs          @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_blog_id_foreign")
  users        users          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "comments_user_id_foreign")
  like_comment like_comment[]
  user_comment user_comment[]

  @@index([blog_id], map: "comments_blog_id_foreign")
  @@index([user_id], map: "comments_user_id_foreign")
}

model course_user {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id  BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  enroll_day Int?
  status     String    @default("in progress") @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  courses    courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_user_course_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "course_user_user_id_foreign")

  @@unique([user_id, course_id], map: "unique_user_course")
  @@index([course_id], map: "course_user_course_id_foreign")
  @@index([user_id], map: "course_user_user_id_foreign")
}

model courses {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name           String           @db.VarChar(255)
  description    String           @db.Text
  image          String?          @db.VarChar(255)
  price          Decimal          @db.Decimal(10, 2)
  days1          String?          @db.VarChar(255)
  days2          String?          @db.VarChar(255)
  enroll_day_1   Int              @default(20)
  enroll_day_2   Int              @default(20)
  duration       String?          @db.VarChar(255)
  category       String?          @db.VarChar(255)
  capacity       Int?
  active         Boolean          @default(true)
  user_id        BigInt           @db.UnsignedBigInt
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  classes        classes[]
  course_user    course_user[]
  users          users            @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "courses_user_id_foreign")
  message_course message_course[]
  payments       payments[]

  @@index([user_id], map: "courses_user_id_foreign")
}

model failed_jobs {
  id         BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid       String   @unique(map: "failed_jobs_uuid_unique") @db.VarChar(255)
  connection String   @db.Text
  queue      String   @db.Text
  payload    String   @db.LongText
  exception  String   @db.LongText
  failed_at  DateTime @default(now()) @db.Timestamp(0)
}

model job_batches {
  id             String  @id @db.VarChar(255)
  name           String  @db.VarChar(255)
  total_jobs     Int
  pending_jobs   Int
  failed_jobs    Int
  failed_job_ids String  @db.LongText
  options        String? @db.MediumText
  cancelled_at   Int?
  created_at     Int
  finished_at    Int?
}

model jobs {
  id           BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  queue        String @db.VarChar(255)
  payload      String @db.LongText
  attempts     Int    @db.UnsignedTinyInt
  reserved_at  Int?   @db.UnsignedInt
  available_at Int    @db.UnsignedInt
  created_at   Int    @db.UnsignedInt

  @@index([queue], map: "jobs_queue_index")
}

model like_blog {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  blog_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  blogs      blogs     @relation(fields: [blog_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "like_blog_blog_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "like_blog_user_id_foreign")

  @@index([blog_id], map: "like_blog_blog_id_foreign")
  @@index([user_id], map: "like_blog_user_id_foreign")
}

model like_comment {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  comment_id BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  comments   comments  @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "like_comment_comment_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "like_comment_user_id_foreign")

  @@index([comment_id], map: "like_comment_comment_id_foreign")
  @@index([user_id], map: "like_comment_user_id_foreign")
}

model likes {
  id            BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id       BigInt    @db.UnsignedBigInt
  likeable_type String    @db.VarChar(255)
  likeable_id   BigInt    @db.UnsignedBigInt
  created_at    DateTime? @db.Timestamp(0)
  updated_at    DateTime? @db.Timestamp(0)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "likes_user_id_foreign")

  @@index([likeable_type, likeable_id], map: "likes_likeable_type_likeable_id_index")
  @@index([user_id], map: "likes_user_id_foreign")
}

model message_course {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  course_id  BigInt    @db.UnsignedBigInt
  message_id BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  courses    courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_course_course_id_foreign")
  messages   messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_course_message_id_foreign")

  @@index([course_id], map: "message_course_course_id_foreign")
  @@index([message_id], map: "message_course_message_id_foreign")
}

model message_user {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  message_id BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  messages   messages  @relation(fields: [message_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_user_message_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "message_user_user_id_foreign")

  @@index([message_id], map: "message_user_message_id_foreign")
  @@index([user_id], map: "message_user_user_id_foreign")
}

model messages {
  id             BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  message        String           @db.Text
  created_at     DateTime?        @db.Timestamp(0)
  updated_at     DateTime?        @db.Timestamp(0)
  message_course message_course[]
  message_user   message_user[]
}

model migrations {
  id        Int    @id @default(autoincrement()) @db.UnsignedInt
  migration String @db.VarChar(255)
  batch     Int
}

model password_reset_tokens {
  email      String    @id @db.VarChar(255)
  token      String    @db.VarChar(255)
  created_at DateTime? @db.Timestamp(0)
}

model payments {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  user_id        BigInt    @db.UnsignedBigInt
  course_id      BigInt    @db.UnsignedBigInt
  preference_id  String?   @db.VarChar(255)
  payment_id     String?   @unique(map: "payments_payment_id_unique") @db.VarChar(255)
  amount         Decimal   @db.Decimal(10, 2)
  status         String    @default("pending") @db.VarChar(255)
  payment_method String?   @db.VarChar(255)
  payment_type   String?   @db.VarChar(255)
  enroll_day     Int?
  metadata       Json?
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)
  courses        courses   @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_course_id_foreign")
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "payments_user_id_foreign")

  @@index([course_id], map: "payments_course_id_foreign")
  @@index([payment_id], map: "payments_payment_id_index")
  @@index([preference_id], map: "payments_preference_id_index")
  @@index([status], map: "payments_status_index")
  @@index([user_id], map: "payments_user_id_foreign")
}

model personal_access_tokens {
  id             BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  tokenable_type String    @db.VarChar(255)
  tokenable_id   BigInt    @db.UnsignedBigInt
  name           String    @db.VarChar(255)
  token          String    @unique(map: "personal_access_tokens_token_unique") @db.VarChar(64)
  abilities      String?   @db.Text
  last_used_at   DateTime? @db.Timestamp(0)
  expires_at     DateTime? @db.Timestamp(0)
  created_at     DateTime? @db.Timestamp(0)
  updated_at     DateTime? @db.Timestamp(0)

  @@index([tokenable_type, tokenable_id], map: "personal_access_tokens_tokenable_type_tokenable_id_index")
}

model role_user {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  role_id    BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  roles      roles     @relation(fields: [role_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_user_role_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "role_user_user_id_foreign")

  @@index([role_id], map: "role_user_role_id_foreign")
  @@index([user_id], map: "role_user_user_id_foreign")
}

model roles {
  id         BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  name       String      @db.VarChar(255)
  created_at DateTime?   @db.Timestamp(0)
  updated_at DateTime?   @db.Timestamp(0)
  role_user  role_user[]
}

model sessions {
  id            String  @id @db.VarChar(255)
  user_id       BigInt? @db.UnsignedBigInt
  ip_address    String? @db.VarChar(45)
  user_agent    String? @db.Text
  payload       String  @db.LongText
  last_activity Int

  @@index([last_activity], map: "sessions_last_activity_index")
  @@index([user_id], map: "sessions_user_id_index")
}

model user_comment {
  id         BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  comment_id BigInt    @db.UnsignedBigInt
  user_id    BigInt    @db.UnsignedBigInt
  created_at DateTime? @db.Timestamp(0)
  updated_at DateTime? @db.Timestamp(0)
  comments   comments  @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_comment_comment_id_foreign")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_comment_user_id_foreign")

  @@index([comment_id], map: "user_comment_comment_id_foreign")
  @@index([user_id], map: "user_comment_user_id_foreign")
}

model users {
  id                BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  name              String         @db.VarChar(255)
  lastname          String?        @db.VarChar(255)
  address           String?        @db.VarChar(255)
  phone             String?        @db.VarChar(255)
  email             String         @unique(map: "users_email_unique") @db.VarChar(255)
  email_verified_at DateTime?      @db.Timestamp(0)
  dni               String?        @db.VarChar(255)
  date_birth        DateTime?      @db.Date
  username          String?        @db.VarChar(255)
  password          String?        @db.VarChar(255)
  remember_token    String?        @db.VarChar(100)
  created_at        DateTime?      @db.Timestamp(0)
  updated_at        DateTime?      @db.Timestamp(0)
  attendances       attendances[]
  avatars           avatars[]
  comments          comments[]
  course_user       course_user[]
  courses           courses[]
  like_blog         like_blog[]
  like_comment      like_comment[]
  likes             likes[]
  message_user      message_user[]
  payments          payments[]
  role_user         role_user[]
  user_comment      user_comment[]
}
